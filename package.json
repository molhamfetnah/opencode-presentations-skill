  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/molhamfetnah/opencode-presentations-skill.git"
  },
  "bugs": {
    "url": "https://github.com/molhamfetnah/opencode-presentations-skill/issues"
  },
  "homepage": "https://github.com/molhamfetnah/opencode-presentations-skill",
  "bin": {
    "present": "./presentations/bin/present"
  },
  "dependencies": {
    "@marp-team/marp-cli": "^4.0.0",
    "apexcharts": "^3.45.0",
    "express": "^4.18.0",
    "ws": "^8.16.0",
    "chokidar": "^3.5.3"
  },
