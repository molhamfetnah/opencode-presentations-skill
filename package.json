  "version": "2.0.0",
  "description": "Enhanced Marp-based presentation generator for OpenCode with 20 styles, carousels, charts, AI images, and live preview",
  "type": "module",
  "keywords": [
    "presentations",
    "slides",
    "marp",
    "opencode",
    "skill"
  ],
